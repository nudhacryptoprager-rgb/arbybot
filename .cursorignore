# Cursor context exclusions for ARBY3.
# Git ignore prevents accidental commits; this file prevents expensive or unsafe
# workspace indexing by Cursor.

# Secrets and local environment
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# Runtime artifacts and generated data
data/runs/
data/runs/**
data/snapshots/
data/snapshots/**
data/reports/
data/reports/**
data/trades/
data/trades/**
data/tmp/
data/tmp/**
data/cache/
data/cache/**
*.sqlite
*.sqlite3

# Logs and caches
logs/
logs/**
*.log
__pycache__/
**/__pycache__/**
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Build and local tooling output
build/
dist/
*.egg-info/
tools/foundry/

# Large or ephemeral generated artifacts
**/run_summary_*.json
**/stability_summary_*.json
**/execution_report_*.json
**/signals_*.json
**/m4_stability_agg*.json
**/_latest.json
**/online_runs_report_*.md

# --- Context savings: historical / operational (M9-active work uses docs/status/) ---
archive/
archive/**

data/quarantine/
data/quarantine/**
data/registry/
data/registry/**

# Static dashboard HTML (edit monitoring/*.py explicitly when needed)
monitoring/*.html

# VCS / Cursor project metadata (not product source)
.git/
.cursor/projects/
**/.cursor/projects/**

# One-off local analysis scripts
scripts/_*.py

# --- Legacy milestones & scratch (re-open paths in brief when touching M4/M7) ---
m4/
m4/**
m7/
m7/**
execution/flash_loan/
execution/flash_loan/**

workdocs/
workdocs/**

todo_RPC_blockers.md
setting_timlid.md

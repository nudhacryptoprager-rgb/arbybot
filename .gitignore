# =============================================================================
# ARBY .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.json


# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local
.env.wallet

# Data (dynamic, not tracked)
data/registry/
data/registry.sqlite
data/snapshots/*.json
data/trades/*.json
data/trades/*.jsonl
data/reports/*.json
data/reports/*.md
# =============================================================================
# RUNTIME ARTIFACTS - NEVER COMMIT (Policy: docs/WORKFLOW.md#artifacts-policy)
# =============================================================================
# All runtime outputs from scans/gates stay local or in CI artifacts.
# Only golden fixtures under docs/artifacts/golden/ are allowed in git.

# Data directory (all runtime)
data/
data/**

# Run-specific artifacts (anywhere in repo)
**/run_summary_*.json
**/stability_summary_*.json
**/execution_report_*.json
**/signals_*.json
**/m4_stability_agg*.json
**/_latest.json
**/online_runs_report_*.md

# Keep directory structure
!data/snapshots/.gitkeep
!data/trades/.gitkeep
!data/reports/.gitkeep
!data/registry/.gitkeep

# Allow golden fixtures only
!docs/artifacts/golden/
!docs/artifacts/golden/**

# Logs
logs/
*.log

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Foundry installer (runtime helper, not source)
foundryup.sh

!.vscode/
!.vscode/tasks.json
.vscode/settings.json
!.github/
!.github/pull_request_template.md
!.github/workflows/
!.github/workflows/ci.yml
!docs/WORKFLOW.md


# Local Foundry install (P4)
tools/foundry/

